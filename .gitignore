# ---- Dependencies -------------------------------------------------------
node_modules/

# ---- Test / lint output -------------------------------------------------
coverage/
.eslintcache
*.lcov

# ---- Editors & IDEs -----------------------------------------------------
.idea/
*.iml
.vscode/
*.code-workspace
*.swp
*~
.claude/

# ---- OS clutter ---------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---- Logs ---------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*

# ---- Local env ----------------------------------------------------------
.env
.env.local

# ---- Replays -------------------------------------------------------------
# Every game against a bot is logged here automatically; the ones worth
# keeping for analysis are copied to data/replays/, which is versioned.
/replays/
/selfplay/
# Bot duels kept as replays (npm run duel), to build later tests on.
/duels/
# Outputs of the night jobs (npm run backlog).
/backlog-runs/


# Oracle positions (npm run oracle): appended as they land, the summary goes to data/.
/oracle/

# Working files a script can write again (scripts/lib/tmp.js): raw dumps,
# rebuilt benches, exports a report is made from. data/ keeps the versioned
# facts and summaries, each file under 500 KB (tests/data-budget.test.js).
/tmp/
